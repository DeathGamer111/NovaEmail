<Project>
  <PropertyGroup>
    <!-- Keep this value synchronized with global.json. The MSBuild check is
         intentional: global.json selection is based on the caller's working
         directory, so invoking a project by path from the repository root must
         still fail closed instead of silently selecting a preview or newer SDK. -->
    <NovaEmailRequiredDotNetSdkVersion>10.0.400</NovaEmailRequiredDotNetSdkVersion>
  </PropertyGroup>

  <Target Name="EnforceNovaEmailDotNetSdk"
          Condition="'$(MSBuildProjectExtension)' == '.csproj'"
          BeforeTargets="PrepareForBuild;Restore">
    <Error Condition="'$(NETCoreSdkVersion)' != '$(NovaEmailRequiredDotNetSdkVersion)'"
           Text="Nova Email requires stable .NET SDK $(NovaEmailRequiredDotNetSdkVersion), but MSBuild selected $(NETCoreSdkVersion). Run dotnet from the Modern directory." />
  </Target>
</Project>
